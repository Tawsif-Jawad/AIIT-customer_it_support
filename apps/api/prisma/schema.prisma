// Prisma Schema for Enterprise Multi-SBU IT Support System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CUSTOMER
  EMPLOYEE
  IT_ADMIN
  CTO
  SYSTEM_SERVICE
}

enum TicketStatus {
  NEW
  TRIAGED
  AI_HANDLING
  RESOLVED_PENDING_CONFIRMATION
  CLOSED
  ASSIGNED_TO_IT
  IN_PROGRESS
  ESCALATED_TO_CTO
  REOPENED
  AWAITING_USER
  AWAITING_APPROVAL
  FAILED_RETRY
}

enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  HANDOVER_PENDING_ACK
  TAKEOVER_PENDING_ACK
  MAINTENANCE
  RETIRED
}

model SBU {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  code        String   @unique
  name        String
  description String?
  slaTier     String   @default("STANDARD")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  auditLogs   AuditLog[]
  users       User[]
  tickets     Ticket[]
  assets      Asset[]
}

model Role {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name        RoleName @unique
  description String
  permissions Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  users       User[]
}

model User {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  email          String   @unique
  displayName    String
  oidcSubject    String?  @unique
  oidcIssuer String?
  adDistinguishedName String?
  sbuId          String
  roleId         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  sbu            SBU      @relation(fields: [sbuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticketEvents TicketEvent[]
  @@unique([id, sbuId])
  requestedTickets Ticket[] @relation("TicketRequester")
  assignedTickets  Ticket[] @relation("TicketAssignee")
  comments       TicketComment[]
  assets         Asset[]
  approvals      Approval[] @relation("ApproverUser")
  notifications  Notification[]
  auditLogs      AuditLog[]
  sessions       AuthSession[]
  requestedApprovals Approval[] @relation("ApprovalRequester")
}

model ServiceCategory {
  id                   String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  slug                 String   @unique
  name                 String
  description          String
  defaultSeverity      TicketSeverity @default(LOW)
  aiEligible           Boolean  @default(true)
  requiresApprovalRole RoleName?
  formSchema           Json
  slaResponseMinutes   Int      @default(60)
  slaResolutionMinutes Int      @default(480)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  tickets              Ticket[]
}

model Ticket {
  version Int @default(0)
  id                 String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  ticketNumber       String         @unique
  title              String
  description        String
  status             TicketStatus   @default(NEW)
  severity           TicketSeverity @default(LOW)
  sbuId              String
  requesterId        String
  assigneeId         String?
  serviceCategoryId  String
  customFormPayload  Json?
  aiSummary          String?
  aiSuggestedFix     String?
  aiConfidence       Float?
  escalationReason   String?
  slaDueAt           DateTime @db.Timestamptz(6)
  resolvedAt         DateTime? @db.Timestamptz(6)
  closedAt           DateTime? @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  sbu                SBU             @relation(fields: [sbuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requester          User            @relation("TicketRequester", fields: [requesterId, sbuId], references: [id, sbuId], onDelete: NoAction, onUpdate: NoAction)
  assignee           User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serviceCategory    ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([requesterId, createdAt])
  @@index([sbuId, status, slaDueAt])
  @@index([assigneeId, status])

  events             TicketEvent[]
  comments           TicketComment[]
  approvals          Approval[]
  aiActionLogs       AIActionLog[]
  notifications      Notification[]
}

model TicketEvent {
  actor User? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  ticketId    String
  actorId     String?
  actorName   String?
  eventType   String
  fromStatus  TicketStatus?
  toStatus    TicketStatus?
  metadata    Json?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model TicketComment {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  ticketId    String
  authorId    String
  authorName  String?
  authorRole  RoleName?
  body        String
  isInternal  Boolean  @default(false)
  attachments Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author      User     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Asset {
  version Int @default(0)
  id                   String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  assetTag             String      @unique
  serialNumber         String      @unique
  category             String
  modelName            String
  status               AssetStatus @default(AVAILABLE)
  sbuId                String
  assignedUserId       String?
  handoverAckStatus    String      @default("ACKNOWLEDGED")
  handoverNotes        String?
  history              Json @default("[]")
  createdAt            DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  sbu                  SBU         @relation(fields: [sbuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedUser         User?       @relation(fields: [assignedUserId, sbuId], references: [id, sbuId], onDelete: NoAction, onUpdate: NoAction)
}

model Approval {
  version Int @default(0)
  id             String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  ticketId       String
  actionType     String
  requiredRole   RoleName
  status         ApprovalStatus @default(PENDING)
  requestedById  String
  approverId     String?
  justification  String
  decisionNotes  String?
  decidedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approver       User?          @relation("ApproverUser", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requester User @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: NoAction)
  @@index([requiredRole, status])

}

model Notification {
  job NotificationJob?
  id             String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  ticketId       String?
  recipientId    String
  recipientEmail String
  channel        String             @default("EMAIL_AND_IN_APP")
  subject        String
  body           String
  status         NotificationStatus @default(QUEUED)
  errorDetails   String?
  readAt         DateTime? @db.Timestamptz(6)
  sentAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)

  ticket         Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recipient      User               @relation(fields: [recipientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AIActionLog {
  id                String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  ticketId          String
  provider          String
  modelName         String
  redactedPrompt    String
  classification    String
  recommendedSeverity TicketSeverity
  confidence        Float
  proposedTool      String?
  policyDecision    String
  dryRun            Boolean  @default(true)
  toolOutput        Json?
  escalatedToIT     Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  ticket            Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model AuditLog {
  sbu SBU? @relation(fields: [sbuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  actorId     String?
  actorEmail  String?
  actorRole   String?
  sbuId       String?
  action      String
  resource    String
  resourceId  String?
  ipAddress   String?
  details     Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model KnowledgeArticle {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  slug        String   @unique
  title       String
  category    String
  tags        String[] @default([])
  content     String
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model AuthSession {
  kind String?
  issuer String?
  subject String?
  id String @id
  userId String
  expiresAt DateTime @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction)
  @@index([userId])
  @@index([expiresAt])
}

model NotificationJob {
  id String @id
  notificationId String @unique
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attempts Int @default(0)
  maxAttempts Int @default(5)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  leaseUntil DateTime? @db.Timestamptz(6)
  leaseToken String?
  state String @default("QUEUED")
  lastError String?
  @@index([state, availableAt])
}

model TicketCounter {
 id String @id
 value Int
}

model AbuseBucket {
  key       String   @id
  hits      Int
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

model OidcLoginFlow {
  id             String   @id
  state          String
  nonce          String
  verifier       String
  expiresAt      DateTime @db.Timestamptz(6)
  previousDigest String?

  @@index([expiresAt])
}

model AbuseKey {
  id String @id
  secret String
}
