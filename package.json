{
  "name": "it-support-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Multi-SBU AI-Powered IT Support Platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node --watch apps/api/src/main.ts",
    "dev:worker": "node --watch apps/worker/src/main.ts",
    "dev:web": "node --watch apps/web/src/server.ts",
    "start:api": "node apps/api/src/main.ts",
    "start:worker": "node apps/worker/src/main.ts",
    "start:web": "node apps/web/src/server.ts",
    "db:seed": "node apps/api/src/prisma/seed.ts",
    "test": "NODE_ENV=test AUTH_MODE=dev_oidc MAIL_PROVIDER=mock node --test tests/*.test.ts",
    "test:unit": "NODE_ENV=test AUTH_MODE=dev_oidc MAIL_PROVIDER=mock node --test tests/unit.test.ts",
    "test:integration": "NODE_ENV=test AUTH_MODE=dev_oidc MAIL_PROVIDER=mock node --test tests/integration.test.ts",
    "test:e2e": "npx playwright test",
    "lint": "eslint apps packages scripts tests playwright.config.ts",
    "build": "npm run typecheck && node scripts/verify-types.ts",
    "typecheck": "tsc --noEmit",
    "test:security": "NODE_ENV=test AUTH_MODE=dev_oidc MAIL_PROVIDER=mock node --test tests/day2.test.ts tests/security.test.ts tests/oidc-security.test.ts",
    "test:db": "node --test tests/database.test.ts",
    "db:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "12.4.1",
    "@nestjs/core": "12.4.1",
    "@nestjs/swagger": "12.1.1",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "next": "15.5.29",
    "nodemailer": "10.4.0",
    "openid-client": "6.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "prettier": "3.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/eslint-plugin": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.32",
      "@prisma/config>deepmerge-ts": "8.0.2",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.5"
    }
  }
}
