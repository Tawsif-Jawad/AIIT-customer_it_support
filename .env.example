# ============================================================================
# Enterprise IT Support System - Environment Configuration Template
# Copy to .env for local development. Never commit real credentials or secrets!
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Server Ports ---
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL Database ---
# JSON is the default. PostgreSQL requires explicit development/test opt-in and a pre-migrated database.
DATABASE_URL=postgresql://itsupport_app:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/it_support_db?schema=public
STORAGE_MODE=json

# --- Redis & BullMQ Background Queue ---
REDIS_URL=redis://localhost:6379
QUEUE_MODE=auto

# --- Keycloak OIDC Authentication ---
AUTH_MODE=dev_oidc
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/upstra-enterprise
KEYCLOAK_CLIENT_ID=it-support-web
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_SECRET
JWT_SIGNING_SECRET=dev-only-hmac-secret-replace-in-production-immediately

# --- Active Directory Integration (Milestone 1: Disabled / Mock Only) ---
# Do NOT configure real corporate AD credentials until LDAPS bridge & change approval are finalized.
AD_ENABLED=false
AD_PROVIDER=mock
AD_LDAPS_URL=ldaps://dc-placeholder.internal.example:636
AD_BASE_DN=DC=internal,DC=example
AD_BIND_DN=CN=svc-itsupport-readonly,OU=ServiceAccounts,DC=internal,DC=example
AD_BIND_PASSWORD=
AD_TLS_CA_CERT_PATH=/etc/ssl/certs/corporate-ad-ca.pem
AD_REQUIRE_APPROVAL_FOR_WRITES=true

# --- Self-Hosted Email Integration (Milestone 1: Mock / Mailpit Only) ---
# NOTE: tawsif.zawad@upstra.com is a reference corporate email identity, NOT a verified mail host.
# Do NOT send real emails or guess SMTP settings until approved mail server parameters are provided.
MAIL_ENABLED=false
MAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply-itsupport@local.dev.invalid
MAIL_PROVISIONING_ENABLED=false

# --- AI Orchestration & Safety Governance ---
AI_PROVIDER=mock
AI_MODEL_NAME=deterministic-policy-mock-v1
AI_MAX_TOKENS_PER_REQUEST=1024
AI_RATE_LIMIT_PER_MINUTE=30
AI_CONFIDENCE_THRESHOLD=0.75
AI_REDACT_PII=true
AI_DRY_RUN_DEFAULT=true

# --- Enterprise OIDC (opt-in; never silently falls back to dev_oidc) ---
# AUTH_MODE=oidc
# OIDC_ISSUER_URL=https://keycloak.test.example/realms/aiit-local
# OIDC_CLIENT_ID=aiit-local
# OIDC_CLIENT_SECRET= # optional: configured confidential client only; never commit
# APP_PUBLIC_URL=https://aiit.test.example
# OIDC_SESSION_SECONDS=1800
# OIDC_ALLOW_INSECURE_LOOPBACK=false
# Local HTTP is accepted only with NODE_ENV=development|test, explicit true,
# and loopback issuer AND application origins. Production always requires HTTPS.
